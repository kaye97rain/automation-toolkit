# Copy this file to .env and fill in real values. Never commit .env.

# General
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Email (SMTP) - for Gmail use an App Password, not your normal password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Slack - incoming webhook URL (simplest) and/or bot token
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=

# AI
ANTHROPIC_API_KEY=

# Google - path to a service-account JSON file
GOOGLE_SERVICE_ACCOUNT_FILE=

# Database (SQLite by default, stored in data/)
DATABASE_URL=sqlite:///data/automation.db
